# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# The coverage report site built by `make cover-site`. CI regenerates it on
# every run and publishes it to Pages; there is nothing here to commit.
/site/

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

# Editor/IDE
.idea/
.vscode/

# MacOS trash
.DS_Store

# Local interop test certs
interop/certs/

# Claude configuration & state
.claude/settings.local.json
.claude/worktrees/

# Local custom prompts
CLAUDE.local.md

# devenv (https://devenv.sh) — generated state; devenv.lock is committed
.devenv*
devenv.local.nix
.direnv/
/relay
/video
# relay-etcd binaries left by `go build` — one for a build from the submodule
# root, one for a build inside the command's own directory. Both are named
# after the directory they land in, so neither pattern can be relaxed into the
# other without also ignoring the source directory itself.
/pkg/relay/discovery/etcd/relay-etcd
/pkg/relay/discovery/etcd/cmd/relay-etcd/relay-etcd

{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledPlugins": {
    "modern-go-guidelines@goland-claude-marketplace": true
  },
  "permissions": {
    "allow": [
      "Bash(go build *)",
      "Bash(go vet *)",
      "Bash(go test *)",
      "Bash(golangci-lint fmt *)",
      "Bash(golangci-lint run *)",
      "Bash(gofmt *)",
      "WebFetch(domain:www.ietf.org)",
			"WebFetch(domain:datatracker.ietf.org)"
    ]
  }
}
